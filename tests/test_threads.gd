extends SceneTree
## Run: godot --headless --path . -s tests/test_threads.gd
## Phase 10g: work moved to threads gives the same result as doing it right here.
## - a column generated by the worker thread equals one generated on the main thread
## - a section mesh built on WorkerThreadPool equals the one built right away

var failed := false


func check(cond: bool, what: String) -> void:
	print(("ok   " if cond else "FAIL ") + what)
	failed = failed or not cond


func _initialize() -> void:
	var w := World.new()
	w.world_seed = 4242
	root.add_child(w)
	await process_frame
	var c := Vector2i(w.gen.spawn.x >> 4, w.gen.spawn.y >> 4) + Vector2i(3, 0)
	w.focus = Vector3(c.x * 16 + 8, 0, c.y * 16 + 8)
	w._request_ahead(c)
	var t := Time.get_ticks_msec()
	while not w._column_ready(c) and Time.get_ticks_msec() - t < 10000:
		await process_frame
	check(w._column_ready(c) and not w.columns.has(c), "worker generated the column")
	w._data(c)
	var g := w.gen.generate(c.x, c.y, World.CHUNK, World.SY)
	check(w.columns[c] == g.blocks, "worker column == main-thread column")
	check(w.heights[c] == World._column_stats(g.blocks).top, "heights from the worker")

	for d in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
		while not w._sky_ready(c + d):
			pass
	var s := -1
	for k in World.SECTIONS:  # a section with faces: the surface
		if w.opaque[c][k] > 0 and w.opaque[c][k] < World.SECTION_VOL:
			s = k
	var now := World._terrain(w._snapshot(c, s, false))
	var snap := w._snapshot(c, s, true)
	var id := WorkerThreadPool.add_task(func() -> void: snap.out = World._terrain(snap))
	WorkerThreadPool.wait_for_task_completion(id)
	var later: Dictionary = snap.out
	check(now.faces > 0 and now.faces == later.faces, "same faces (%d)" % now.faces)
	check(now.buf.v == later.buf.v and now.buf.col == later.buf.col and now.buf.uv2 == later.buf.uv2,
		"same vertices, AO and light")
	check(now.grass == later.grass, "same tall grass spots")

	w.queue_free()
	await process_frame
	print("test_threads " + ("FAILED" if failed else "OK"))
	quit(1 if failed else 0)
